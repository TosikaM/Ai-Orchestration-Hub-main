{
  "$schema": "./stack-mappings.schema.json",
  "version": 2,
  "description": "Maps repo indicator files to skills, agents, templates, and commands. Commands are candidate lists — verification-loop tries them in order and reports which one actually ran. detectionOrder runs most-specific first: nextjs must be tested before react because a Next.js repo also declares a react dependency, and dotnet-cqrs before dotnet-shared-lib for the same reason.",
  "stacks": [
    { "id": "dotnet-cqrs", "name": ".NET CQRS (command side)",
      "indicators": [{ "file": "*.csproj", "contains": "MediatR" }, { "directory": "Commands" }, { "directory": "Handlers" }],
      "templates": ["dotnet"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "analyst", "security"],
      "commands": { "build": ["dotnet build"], "test": ["dotnet test"], "lint": ["dotnet format --verify-no-changes"], "format": ["dotnet format"] },
      "conventions": { "namingConvention": "PascalCase", "mappingMechanism": "Detect it — explicit mapping, a source generator such as Mapperly, or AutoMapper in older code. AutoMapper and MediatR are forbidden for NEW work by config/architecture-baseline.json on licence grounds; this field describes what an existing repo may already use.", "testPattern": "*.Tests project, xUnit" } },

    { "id": "dotnet-query", "name": ".NET Query (read side)",
      "indicators": [{ "file": "*.csproj", "contains": "Dapper" }, { "directory": "Queries" }],
      "templates": ["dotnet"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["dotnet build"], "test": ["dotnet test"], "lint": ["dotnet format --verify-no-changes"], "format": ["dotnet format"] },
      "conventions": { "namingConvention": "PascalCase", "queryPattern": "Dapper with read models", "testPattern": "*.Tests project, xUnit" } },

    { "id": "dotnet-shared-lib", "name": ".NET shared library",
      "indicators": [{ "file": "*.csproj", "contains": "<PackageId>" }],
      "templates": ["dotnet"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "release-engineering"],
      "agents": ["developer", "reviewer", "analyst", "architect"],
      "commands": { "build": ["dotnet build", "dotnet pack"], "test": ["dotnet test"] },
      "conventions": { "namingConvention": "PascalCase", "versioning": "SemVer via PackageVersion" } },

    { "id": "angular", "name": "Angular",
      "indicators": [{ "file": "angular.json" }, { "file": "package.json", "contains": "\"@angular/core\"" }],
      "templates": ["angular"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "structural-graph"],
      "agents": ["developer", "reviewer", "qa", "analyst"],
      "commands": { "build": ["npm run build", "ng build"], "test": ["npm test", "ng test"], "lint": ["npm run lint", "ng lint"], "format": ["npx prettier --write ."], "serve": ["ng serve", "npm start"] },
      "conventions": { "componentNaming": "kebab-case.component.ts", "stateManagement": "Detect it — signals, RxJS services, or NgRx. Signals plus a scoped service are the baseline for NEW work per config/architecture-baseline.json; adding a store beside them is a decision, not a detail.", "testPattern": "*.spec.ts, colocated" } },

    { "id": "nextjs", "name": "Next.js",
      "indicators": [{ "file": "next.config.js" }, { "file": "next.config.mjs" }, { "file": "next.config.ts" }],
      "templates": ["node"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["npm run build"], "test": ["npm test", "npx vitest run"], "lint": ["npm run lint", "npx eslint ."], "format": ["npx prettier --write ."], "serve": ["npm run dev"] },
      "conventions": { "routing": "App Router or Pages Router — detect before assuming", "testPattern": "*.test.tsx" } },

    { "id": "react", "name": "React",
      "indicators": [{ "file": "package.json", "contains": "\"react\"" }],
      "templates": ["node"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["npm run build"], "test": ["npm test", "npx vitest run", "npx jest"], "lint": ["npx eslint ."], "format": ["npx prettier --write ."] },
      "conventions": { "componentNaming": "PascalCase", "testPattern": "*.test.tsx" } },

    { "id": "vue", "name": "Vue",
      "indicators": [{ "file": "package.json", "contains": "\"vue\"" }],
      "templates": ["node"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["npm run build"], "test": ["npx vitest run", "npm test"], "lint": ["npx eslint ."], "format": ["npx prettier --write ."] },
      "conventions": { "componentNaming": "PascalCase SFC", "stateManagement": "Pinia", "testPattern": "*.spec.ts" } },

    { "id": "svelte", "name": "Svelte / SvelteKit",
      "indicators": [{ "file": "svelte.config.js" }, { "file": "package.json", "contains": "\"svelte\"" }],
      "templates": ["node"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["npm run build"], "test": ["npx vitest run"], "lint": ["npm run lint"], "format": ["npx prettier --write ."] },
      "conventions": { "componentNaming": "PascalCase.svelte", "testPattern": "*.test.ts" } },

    { "id": "spring-boot", "name": "Spring Boot (Java)",
      "indicators": [{ "file": "pom.xml", "contains": "spring-boot-starter" }, { "file": "build.gradle", "contains": "spring-boot" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["mvn clean package", "./gradlew build"], "test": ["mvn test", "./gradlew test"], "lint": ["mvn checkstyle:check"] },
      "conventions": { "namingConvention": "PascalCase classes", "testPattern": "*Test.java, JUnit" } },

    { "id": "kotlin-spring", "name": "Spring Boot (Kotlin)",
      "indicators": [{ "file": "build.gradle.kts", "contains": "spring-boot" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["./gradlew build"], "test": ["./gradlew test"], "lint": ["./gradlew ktlintCheck"], "format": ["./gradlew ktlintFormat"] },
      "conventions": { "namingConvention": "PascalCase classes", "testPattern": "*Test.kt" } },

    { "id": "django", "name": "Django",
      "indicators": [{ "file": "manage.py" }],
      "templates": ["python"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["python -m build"], "test": ["python manage.py test", "pytest"], "lint": ["ruff check ."], "format": ["ruff format ."], "serve": ["python manage.py runserver"] },
      "conventions": { "namingConvention": "snake_case modules", "testPattern": "tests.py or test_*.py" } },

    { "id": "fastapi", "name": "FastAPI",
      "indicators": [{ "file": "pyproject.toml", "contains": "fastapi" }, { "file": "requirements.txt", "contains": "fastapi" }],
      "templates": ["python"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["python -m build"], "test": ["pytest", "pytest --cov"], "lint": ["ruff check .", "pyright ."], "format": ["ruff format ."] },
      "conventions": { "namingConvention": "snake_case", "mappingMechanism": "Pydantic models", "testPattern": "test_*.py" } },

    { "id": "go", "name": "Go",
      "indicators": [{ "file": "go.mod" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop", "security-review"],
      "agents": ["developer", "reviewer", "qa", "security"],
      "commands": { "build": ["go build ./..."], "test": ["go test ./..."], "lint": ["golangci-lint run", "go vet ./..."], "format": ["gofmt -w ."] },
      "conventions": { "namingConvention": "lowercase packages, MixedCaps identifiers", "testPattern": "*_test.go" } },

    { "id": "rust", "name": "Rust",
      "indicators": [{ "file": "Cargo.toml" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["cargo build"], "test": ["cargo test"], "lint": ["cargo clippy -- -D warnings"], "format": ["cargo fmt"] },
      "conventions": { "namingConvention": "snake_case functions, PascalCase types", "testPattern": "#[cfg(test)] modules" } },

    { "id": "terraform", "name": "Terraform",
      "indicators": [{ "file": "*.tf" }, { "file": "terraform.tfvars" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "verification-loop", "security-review", "release-engineering"],
      "agents": ["analyst", "reviewer", "security", "architect"],
      "commands": { "build": ["terraform validate"], "test": ["terraform plan"], "lint": ["terraform fmt -check"], "format": ["terraform fmt"] },
      "conventions": { "namingConvention": "snake_case resources" },
      "forbiddenCommands": ["terraform apply", "terraform destroy"],
      "forbiddenCommandsReason": "State-mutating infrastructure commands must never run from an agent context. This is enforced by the destructive-gate hook, not left as prose in a config file." },

    { "id": "kubernetes", "name": "Kubernetes manifests",
      "indicators": [{ "file": "Chart.yaml" }, { "file": "kustomization.yaml" }],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "verification-loop", "security-review", "release-engineering"],
      "agents": ["analyst", "reviewer", "security"],
      "commands": { "build": ["helm template .", "kustomize build ."], "test": ["helm lint ."], "lint": ["kubeconform -summary ."] },
      "conventions": { "namingConvention": "kebab-case resources" },
      "forbiddenCommands": ["kubectl delete", "kubectl apply -f", "helm uninstall"],
      "forbiddenCommandsReason": "Cluster-mutating commands must never run from an agent context." },

    { "id": "node-typescript", "name": "Node.js + TypeScript",
      "indicators": [{ "file": "tsconfig.json" }, { "file": "package.json", "contains": "typescript" }],
      "templates": ["node"],
      "skills": ["repo-context-builder", "cqrs-developer", "quality-sentinel", "verification-loop"],
      "agents": ["developer", "reviewer", "qa"],
      "commands": { "build": ["npm run build", "npx tsc"], "test": ["npm test", "npx vitest run", "npx jest"], "lint": ["npx eslint ."], "format": ["npx prettier --write ."] },
      "conventions": { "namingConvention": "camelCase functions, PascalCase types", "testPattern": "*.test.ts" } },

    { "id": "unknown", "name": "Unknown / generic",
      "indicators": [],
      "templates": ["generic"],
      "skills": ["repo-context-builder", "quality-sentinel", "grounding-guard"],
      "agents": ["analyst", "reviewer"],
      "commands": {},
      "conventions": { "note": "Nothing detected. Read the repo before asserting any convention." } }
  ],
  "detectionOrder": [
    "dotnet-cqrs", "dotnet-query", "dotnet-shared-lib",
    "angular", "nextjs", "vue", "svelte", "react",
    "kotlin-spring", "spring-boot",
    "django", "fastapi",
    "go", "rust", "terraform", "kubernetes",
    "node-typescript", "unknown"
  ],
  "verifiedCommandsRule": "When no candidate command in a stack works, ask the user once and persist the answer to the consumer repo's .github/orchestrator-context.md under '## Verified Commands'. The context generator must never overwrite that section. A one-time question that persists beats a permanent 'not detected'."
}
